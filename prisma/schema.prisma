generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  role          String    @default("ADMIN")
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  servers       Server[]
  bans          BannedPlayer[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Player {
  id        String   @id @default(cuid())
  name      String?
  hwid      String?
  ip        String?
  license   String?
  steamId   String?
  discordId String?
  fivemId   String?
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  serverId  String
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  bans      BannedPlayer[]
}

model Server {
  id           String         @id @default(cuid())
  userId       String
  name         String
  ip           String
  port         Int
  isActive     Boolean        @default(true)
  apiKey       String         @unique
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?
  bans         BannedPlayer[]
  detections   DetectionLog[]
  apiKeys      APIKey[]
  players      Player[]
  licenseKeys  LicenseKey[]
}

model Subscription {
  id                   String   @id @default(cuid())
  serverId             String   @unique
  plan                 String   @default("FREE")
  interval             String   @default("MONTHLY")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String   @default("ACTIVE")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime @default(now())
  server               Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model LicenseKey {
  id        String    @id @default(cuid())
  key       String    @unique
  plan      String
  status    String    @default("PENDING")
  serverId  String?
  serverIp  String?
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  renewedAt DateTime?
  server    Server?   @relation(fields: [serverId], references: [id])
  logs      KeyLog[]
}

model KeyLog {
  id        String   @id @default(cuid())
  keyId     String
  action    String
  detail    String?
  createdAt DateTime @default(now())
  key       LicenseKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
}

model BannedPlayer {
  id         String     @id @default(cuid())
  license    String
  steamId    String?
  discordId  String?
  fivemId    String?
  playerId   String?
  playerName String?
  hwid       String?
  ip         String?
  reason     String
  evidence   String?
  bannedById String
  serverId   String
  isActive   Boolean    @default(true)
  bannedAt   DateTime   @default(now())
  expiresAt  DateTime?
  unbannedAt DateTime?
  server     Server     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  bannedBy   User       @relation(fields: [bannedById], references: [id])
  player     Player?    @relation(fields: [playerId], references: [id])
  proofs     BanProof[]
}

model BanProof {
  id        String   @id @default(cuid())
  banId     String
  type      String   @default("URL")
  value     String
  createdAt DateTime @default(now())
  ban       BannedPlayer @relation(fields: [banId], references: [id], onDelete: Cascade)
}

model DetectionLog {
  id             String   @id @default(cuid())
  playerLicense  String
  detectionType  String
  severity       String   @default("MID")
  metadata       String   @default("{}")
  serverId       String
  createdAt      DateTime @default(now())
  server         Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model APIKey {
  id         String    @id @default(cuid())
  key        String    @unique
  serverId   String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  server     Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

model PricingPlan {
  id       String  @id @default(cuid())
  plan     String
  interval String  @default("MONTHLY")
  price    Int
  isActive Boolean @default(true)

  @@unique([plan, interval])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())
}
